DATABASE_URL=postgresql://apex_ecommerce:devpass@127.0.0.1:5434/apex_ecommerce
PAYLOAD_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
SITE_URL=http://localhost:3000
# Undangan user dikirim lewat email: SITE_URL harus alamat publik admin (dipakai membangun tautan undangan)
# dan SMTP_HOST wajib diisi. Masa berlaku tautan dalam jam (1-336, bawaan 72).
USER_INVITE_EXPIRY_HOURS=72
# Job terjadwal (kedaluwarsa hold, reminder H-1) berjalan di dalam app. Set false pada instance tambahan.
JOBS_AUTORUN=true

# Produksi wajib mengisi SMTP_HOST, SMTP_USER, SMTP_PASS, dan SMTP_FROM_ADDRESS.
# Gunakan alamat pengirim dari domain sendiri dengan SPF/DKIM yang sudah diset agar email tidak masuk spam.
# Kosongkan SMTP_HOST hanya untuk development (email akan dicetak ke console).
# Cookie sesi hanya lewat HTTPS (wajib true di produksi yang memakai HTTPS).
COOKIE_SECURE=false
# Origin tambahan yang boleh memanggil API (pisahkan koma). Kosongkan bila storefront satu domain dengan admin.
ALLOWED_ORIGINS=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=APEX

# Booking payments: select the active provider in Admin → Pengaturan → Booking.
# Midtrans sandbox; use production key and set true only for production.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
# Xendit invoice payments and callback verification.
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
